{
    "bot_name": "NFIX7_bot",
    "strategy": "NostalgiaForInfinityX7",
    "add_config_files": [
        "/nfi-repo/configs/exampleconfig-rebuy.json",
        "/nfi-repo/configs/trading_mode-futures.json",
        "/nfi-repo/configs/pairlist-volume-hyperliquid-usdc.json",
        "/nfi-repo/configs/blacklist-hyperliquid.json"
    ],

    "initial_state": "running",
    "user_data_dir": "/freqtrade/user_data",
    "strategy_path": "/nfi-repo",
    "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite",

    "dry_run": true,
    "dry_run_wallet": 500,
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 10,
    "cancel_open_orders_on_exit": false,

    "stake_currency": "USDC",
    "stake_amount": "unlimited",
    "fiat_display_currency": "USD",

    "exchange": {
        "name": "hyperliquid",
        "key": "",
        "secret": "",
        "walletAddress": "",
        "privateKey": "",
        "ccxt_config": {},
        "ccxt_async_config": {}
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "ws_token": "",
        "username": "",
        "password": "",
        "CORS_origins": [
            "https://instance-2026sep.tail57ff4c.ts.net",
            "https://instance-2026sep.tail57ff4c.ts.net:8443",
            "https://instance-2026sep.tail57ff4c.ts.net:9443"
        ]
    },

    "telegram": {
        "enabled": true,
        "token": "",
        "chat_id": "",
        "keyboard": [
            ["/status table", "/count", "/balance"],
            ["/profit", "/daily", "/performance"],
            ["/whitelist", "/locks", "/show_config"],
            ["/forceexit", "/stopentry", "/reload_config"]
        ],
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "exit": "on",
            "entry_fill": "on",
            "exit_fill": "on"
        }
    },

    "shared_ohlcv_cache": {
        "enabled": true,
        "socket_path": "/ftcache/ftcache.sock"
    }
}
