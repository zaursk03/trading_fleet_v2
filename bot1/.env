# ═══════════════════════════════════════════════════════════════
#  botN/.env — SEGRETI specifici di QUESTO bot
#  Formato: FREQTRADE__SEZIONE__CAMPO=valore  (doppio _ = livello)
#  Priorità: .env.shared (primo) → questo file (ultimo, vince).
#  Le env battono SEMPRE il JSON: i placeholder vuoti nel
#  config.json sono innocui con questo canale.
#  Qui SOLO segreti. TZ / chat_id / fiat stanno in .env.shared.
#  Rate-limit: NON qui — ftcache lo centralizza; le chiavi
#  ccxt rateLimit/enableRateLimit vengono ignorate.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
#  EXCHANGE — decommenta UN SOLO blocco
# ───────────────────────────────────────────────────────────────

# HYPERLIQUID (DEX)
#   walletAddress = indirizzo dell'account (pubblico)
#   privateKey    = chiave privata dell'API AGENT (segreto):
#                   trade-only, MAI withdraw, MAI chiave principale.
#   Vault / subaccount = indirizzo PUBBLICO, non segreto → mettilo
#   in config.json (exchange.ccxt_config.options.vaultAddress /
#   subAccountAddress), NON in una JSON-stringa dentro .env.
#FREQTRADE__EXCHANGE__WALLETADDRESS=0x_INDIRIZZO_ACCOUNT
#FREQTRADE__EXCHANGE__PRIVATEKEY=0x_CHIAVE_API_AGENT

# KRAKEN (CEX) — key/secret trade-only, no withdraw
#FREQTRADE__EXCHANGE__KEY=API_KEY_KRAKEN
#FREQTRADE__EXCHANGE__SECRET=API_SECRET_KRAKEN

# ───────────────────────────────────────────────────────────────
#  TELEGRAM — token per-bot (@BotFather). chat_id in .env.shared.
# ───────────────────────────────────────────────────────────────
FREQTRADE__TELEGRAM__TOKEN=PLACEHOLDER_BOTFATHER

# ───────────────────────────────────────────────────────────────
#  API SERVER — UNIVOCI per bot, mai condivisi
#  Genera:
#    ws/jwt :  openssl rand -hex 32
#    password: openssl rand -base64 24
# ───────────────────────────────────────────────────────────────
FREQTRADE__API_SERVER__USERNAME=adminN
FREQTRADE__API_SERVER__PASSWORD=PLACEHOLDER_FORTE
FREQTRADE__API_SERVER__WS_TOKEN=PLACEHOLDER_HEX32
FREQTRADE__API_SERVER__JWT_SECRET_KEY=PLACEHOLDER_HEX32
