# ═══════════════════════════════════════════════════════════════
#  1 · SEGRETI / FILE LOCALI — MAI committare (presenti in working tree)
# ═══════════════════════════════════════════════════════════════
.env.shared
.env.backup
**/.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials*
# config reale per-bot: contiene walletAddress/privateKey (camelCase HL).
# Resta locale con quel nome; git non lo traccia né lo committerà.
bot*/user_data/config.json

# ═══════════════════════════════════════════════════════════════
#  2 · TEMPLATE DA COMMITTARE (negazioni: l'ultima regola che matcha vince)
#     Coprono entrambe le convenzioni finché non standardizzi il naming.
# ═══════════════════════════════════════════════════════════════
!**/.env.example
!**/.env.*.example
!bot*/user_data/*.example.json
!bot*/user_data/*.json.example

# ═══════════════════════════════════════════════════════════════
#  3 · RICERCA: script/config/strategie committati; solo OUTPUT ignorati
# ═══════════════════════════════════════════════════════════════
shared/local/sviluppo/*.csv
shared/local/sviluppo/log_*.txt
# JSON stray (es. params hyperopt co-located): non committare overfit
shared/local/sviluppo/*.json
!shared/local/sviluppo/config-dev.json
!shared/local/sviluppo/experiment.json

# ═══════════════════════════════════════════════════════════════
#  4 · DATABASE
# ═══════════════════════════════════════════════════════════════
**/*.sqlite
**/*.sqlite3
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm

# ═══════════════════════════════════════════════════════════════
#  5 · DATI, LOG, CACHE, RUNTIME IPC
# ═══════════════════════════════════════════════════════════════
**/user_data/data/
**/user_data/logs/
**/user_data/backtest_results/
**/user_data/hyperopt_results/
**/klines_cache/
dev/user_data/
**/*.pkl
**/*.fthypt
**/*.feather
backups/
**/*.log
shared/run/
shared/cache/
*.sock

# ═══════════════════════════════════════════════════════════════
#  6 · REPO ESTERNE (clonate separatamente, non vendorate qui)
# ═══════════════════════════════════════════════════════════════
shared/NostalgiaForInfinity/
freqtrade-ultimate/
shared/frequi/

# ═══════════════════════════════════════════════════════════════
#  7 · PYTHON / TEST CACHE
# ═══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ═══════════════════════════════════════════════════════════════
#  8 · RUNTIME / PID / LOCK
# ═══════════════════════════════════════════════════════════════
*.pid
*.seed
*.pid.lock

# ═══════════════════════════════════════════════════════════════
#  9 · DIRENV
# ═══════════════════════════════════════════════════════════════
.envrc
.direnv/

# ═══════════════════════════════════════════════════════════════
#  10 · IDE E OS
# ═══════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ═══════════════════════════════════════════════════════════════
#  11 · BACKUP / TEMP / ARCHIVI
# ═══════════════════════════════════════════════════════════════
*.bak
*.tmp
*.backup
*.orig
*.zip
*.tar.gz
