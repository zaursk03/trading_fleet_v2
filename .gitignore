# ═══════════════════════════════════════════════════════════════
#  SEGRETI / FILE LOCALI — MAI committare (presenti in working tree)
# ═══════════════════════════════════════════════════════════════
.env.shared
.env.backup
**/.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
secrets/
credentials*
# config reale per-bot: contiene walletAddress/privateKey (camelCase HL).
# Resta locale con quel nome; git non lo traccia né lo committerà.
bot*/user_data/config.json

# ═══════════════════════════════════════════════════════════════
#  RICERCA: script/config/strategie committati; solo OUTPUT ignorati
# ═══════════════════════════════════════════════════════════════
shared/local/sviluppo/*.csv
shared/local/sviluppo/log_*.txt

# ═══════════════════════════════════════════════════════════════
#  DATABASE
# ═══════════════════════════════════════════════════════════════
**/*.sqlite
**/*.sqlite3
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm

# ═══════════════════════════════════════════════════════════════
#  DATI, LOG, CACHE, RUNTIME IPC
# ═══════════════════════════════════════════════════════════════
**/user_data/data/
**/user_data/logs/
**/user_data/backtest_results/
**/user_data/hyperopt_results/
**/klines_cache/
dev/user_data/
**/*.pkl
**/*.fthypt
**/*.feather
backups/
**/*.log
shared/run/
shared/cache/
*.sock

# ═══════════════════════════════════════════════════════════════
#  REPO ESTERNE (clonate separatamente, non vendorate qui)
# ═══════════════════════════════════════════════════════════════
shared/NostalgiaForInfinity/
freqtrade-ultimate/

# ═══════════════════════════════════════════════════════════════
#  PYTHON
# ═══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ═══════════════════════════════════════════════════════════════
#  RUNTIME / PID / LOCK
# ═══════════════════════════════════════════════════════════════
*.pid
*.seed
*.pid.lock

# ═══════════════════════════════════════════════════════════════
#  DIRENV
# ═══════════════════════════════════════════════════════════════
.envrc
.direnv/

# ═══════════════════════════════════════════════════════════════
#  IDE E OS
# ═══════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ═══════════════════════════════════════════════════════════════
#  BACKUP / TEMP / ARCHIVI
# ═══════════════════════════════════════════════════════════════
*.bak
*.tmp
*.backup
*.orig
*.zip
*.tar.gz
