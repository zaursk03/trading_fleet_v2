{
    "exchange": {
        "name": "hyperliquid",
        "pair_whitelist": [
            "BTC/USDC:USDC", "ETH/USDC:USDC", "SOL/USDC:USDC", "XRP/USDC:USDC",
            "UNI/USDC:USDC", "AAVE/USDC:USDC", "LINK/USDC:USDC", "AVAX/USDC:USDC",
            "DOGE/USDC:USDC", "LTC/USDC:USDC", "SUI/USDC:USDC", "ENA/USDC:USDC"
        ],
        "pair_blacklist": [ ".*USDC/USDC.*", ".*USDT/USDC.*", ".*DAI/USDC.*" ]
    },
    "pairlists": [ { "method": "StaticPairList" } ],

    "strategy": "Strategy_name",
    "timeframe": "15m",
    "trading_mode": "futures",
    "margin_mode": "isolated",

    "stake_currency": "USDC",
    "stake_amount": 30,
    "max_open_trades": 3,
    "available_capital": 600,
    "dry_run_wallet": 600,
    "tradable_balance_ratio": 0.5,

    "use_custom_stoploss": false,
    "position_adjustment_enable": false,

    "entry_pricing": {
        "price_side": "same", "use_order_book": true, "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 }
    },
    "exit_pricing": {
        "price_side": "same", "use_order_book": true, "order_book_top": 1,
        "price_last_balance": 0.5
    },
    "order_types": { "entry": "limit", "exit": "limit", "stoploss": "market" },
    "order_time_in_force": { "entry": "GTC", "exit": "GTC" },
    "unfilledtimeout": { "entry": 15, "exit": 10, "exit_timeout_count": 2, "unit": "minutes" }
}
