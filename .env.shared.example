# ═══════════════════════════════════════════════════════════════
#  .env.shared — valori NON sensibili comuni a tutta la flotta
#  Caricato PRIMO in env_file; botN/.env (ultimo) fa override.
#  Qui SOLO non-segreti. I segreti (Telegram token, password API,
#  WS_TOKEN, JWT, exchange key/secret) vivono SOLO in botN/.env.
#  I camelCase Hyperliquid (walletAddress/privateKey) nel config.json.
#  Reale = .env.shared (ignorato da git); questo è il template.
# ═══════════════════════════════════════════════════════════════

# Timezone: UTC obbligatorio (dati/funding/candele sono UTC).
# Localizza in FreqUI/Telegram, non nel motore.
TZ=UTC

# Chat ID Telegram comune (identificatore, non segreto).
# Ricavalo: manda /start al bot, poi apri
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# e cerca "chat":{"id":...}. Il TOKEN del bot è per-bot in botN/.env.
FREQTRADE__TELEGRAM__CHAT_ID=

# Valuta di display nei report/UI.
FREQTRADE__FIAT_DISPLAY_CURRENCY=EUR

# NIENTE WS_TOKEN qui: un fallback condiviso = un token compromesso
# apre tutta la flotta. Ogni bot definisce il proprio in botN/.env.
